{
	"name": "@snylonue/dsh-spawn",
	"version": "1.0.2",
	"description": "A tool call for direct argv execution and optional filesystem query tools for DeepSeek Harness",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"dsh-plugin"
	],
	"repository": "github:snylonue/dsh-spawn",
	"packageManager": "pnpm@12.3.4",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"dsh": "^0.2.0-rc.2 || ^0.2.1-rc.1"
	},
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./stat": {
			"types": "./dist/stat.d.ts",
			"default": "./dist/stat.js"
		},
		"./list-dir": {
			"types": "./dist/list-dir.d.ts",
			"default": "./dist/list-dir.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./locale/*.json": "./locale/*.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"cordis.patch.yml",
		"locale/*.json",
		"README.md",
		"LICENSE"
	],
	"dsh": {
		"manifestVersion": 1,
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepare": "tsc -p tsconfig.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
		"test": "pnpm build && vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"lint": "biome lint ."
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.4",
		"@deepseek-ai/dsh-fs": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-jobs": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-sandbox-policy": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-shell": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-shell-env": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-subprocess": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2 || ^0.2.1-rc.1",
		"@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-rc.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2",
		"@deepseek-ai/cordis": "~4.0.4",
		"@deepseek-ai/dsh-agent": "0.2.0-rc.2",
		"@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
		"@deepseek-ai/dsh-brand": "0.2.0-rc.2",
		"@deepseek-ai/dsh-fs": "0.2.0-rc.2",
		"@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
		"@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2",
		"@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
		"@deepseek-ai/dsh-jobs-local": "0.2.0-rc.2",
		"@deepseek-ai/dsh-llm": "0.2.0-rc.2",
		"@deepseek-ai/dsh-output-retention": "0.2.0-rc.2",
		"@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
		"@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
		"@deepseek-ai/dsh-scope": "0.2.0-rc.2",
		"@deepseek-ai/dsh-session": "0.2.0-rc.2",
		"@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
		"@deepseek-ai/dsh-shell": "0.2.0-rc.2",
		"@deepseek-ai/dsh-shell-env": "0.2.0-rc.2",
		"@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
		"@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
		"@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
		"@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
		"@deepseek-ai/dsh-tool-bash": "0.2.0-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.0-rc.2",
		"@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
		"@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"meta": {
		"title": "Spawn",
		"description": "A tool call to run programs directly by argv without a shell, with optional file metadata and directory tools."
	}
}
